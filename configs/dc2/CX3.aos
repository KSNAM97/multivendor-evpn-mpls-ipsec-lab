!
hostname CX3
!
user admin group administrators password plaintext admin1234
!
cli-session
    timeout 0
!
interface mgmt
    no shutdown
    ip static 192.168.100.43/24
!
ssh server vrf mgmt
!
banner motd !
LAB CX3 - authorized use only
!
vlan 110
    name APP-DC2
!
vlan 999
    name NATIVE
!
interface lag 10
    no shutdown
    description to-VSX-pair
    no routing
    vlan trunk native 999
    vlan trunk allowed 110
    lacp mode active
!
interface 1/1/1
    no shutdown
    lag 10
!
interface 1/1/2
    no shutdown
    lag 10
!
interface 1/1/3
    no shutdown
    lag 10
!
interface 1/1/4
    no shutdown
    lag 10
!
interface 1/1/5
    no shutdown
    description to-HostD
    spanning-tree port-type admin-edge
    no routing
    vlan access 110
!
