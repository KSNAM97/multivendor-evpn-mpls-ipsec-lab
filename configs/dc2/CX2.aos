!
hostname CX2
!
user admin group administrators password plaintext admin1234
!
cli-session
    timeout 0
!
interface mgmt
    no shutdown
    ip static 192.168.100.42/24
!
ssh server vrf mgmt
!
banner motd !
LAB CX2 - authorized use only
!
vrf KEEPALIVE
!
vlan 110
    name APP-DC2
!
vlan 999
    name NATIVE
!
vrf TENANT-A
    rd 65201:1
!
interface loopback 0
    ip address 10.2.0.2/32
!
interface lag 256
    no shutdown
    description VSX-ISL
    no routing
    vlan trunk native 999
    vlan trunk allowed all
    lacp mode active
!
interface 1/1/1
    no shutdown
    description PE2 to Gi3/0
    vrf attach TENANT-A
    ip address 10.0.20.7/31
!
interface 1/1/2
    no shutdown
    lag 256
!
interface 1/1/3
    no shutdown
    lag 256
!
interface 1/1/4
    no shutdown
    description VSX-KEEPALIVE
    vrf attach KEEPALIVE
    ip address 10.2.254.1/31
!
vsx
    system-mac 02:00:00:00:01:01
    inter-switch-link lag 256
    role secondary
    keepalive peer 10.2.254.0 source 10.2.254.1 vrf KEEPALIVE
!
interface lag 10 multi-chassis
    no shutdown
    description to-CX3
    no routing
    vlan trunk native 999
    vlan trunk allowed 110
    lacp mode active
!
interface 1/1/5
    no shutdown
    lag 10
!
interface 1/1/6
    no shutdown
    lag 10
!
interface vlan 110
    description APP-DC2
    vrf attach TENANT-A
    ip address 192.168.110.3/24
    active-gateway ip mac 12:00:00:00:01:10
    active-gateway ip 192.168.110.1
!
router bgp 65201
    bgp router-id 10.2.2.2
    vrf TENANT-A
        bgp router-id 10.2.2.2
        neighbor 10.0.20.6 remote-as 65000
        neighbor 10.0.20.6 timers 3 9
        address-family ipv4 unicast
            neighbor 10.0.20.6 activate
            redistribute connected
        exit-address-family
!