!
hostname CX1
!
user admin group administrators password plaintext admin1234
!
cli-session
    timeout 0
!
interface mgmt
    no shutdown
    ip static 192.168.100.41/24
!
ssh server vrf mgmt
!
banner motd !
LAB CX1 - authorized use only
!
vrf KEEPALIVE
!
vlan 110
    name APP-DC2
!
vlan 999
    name NATIVE
!
vrf TENANT-A
    rd 65201:1
!
interface loopback 0
    ip address 10.2.0.1/32
!
interface lag 256
    no shutdown
    description VSX-ISL
    no routing
    vlan trunk native 999
    vlan trunk allowed all
    lacp mode active
!
interface 1/1/1
    no shutdown
    description PE2 to Gi2/0
    vrf attach TENANT-A
    ip address 10.0.20.5/31
!
interface 1/1/2
    no shutdown
    lag 256
!
interface 1/1/3
    no shutdown
    lag 256
!
interface 1/1/4
    no shutdown
    description VSX-KEEPALIVE
    vrf attach KEEPALIVE
    ip address 10.2.254.0/31
!
vsx
    system-mac 02:00:00:00:01:01
    inter-switch-link lag 256
    role primary
    keepalive peer 10.2.254.1 source 10.2.254.0 vrf KEEPALIVE
!
interface lag 10 multi-chassis
    no shutdown
    description to-CX3
    no routing
    vlan trunk native 999
    vlan trunk allowed 110
    lacp mode active
!
interface 1/1/5
    no shutdown
    lag 10
!
interface 1/1/6
    no shutdown
    lag 10
!
interface vlan 110
    description APP-DC2
    vrf attach TENANT-A
    ip address 192.168.110.2/24
    active-gateway ip mac 12:00:00:00:01:10
    active-gateway ip 192.168.110.1
!
interface 1/1/7
    no shutdown
    description to-HostD-eth1
    no routing
    vlan access 110
!
router bgp 65201
    bgp router-id 10.2.2.1
    vrf TENANT-A
    bgp router-id 10.2.2.1
        neighbor 10.0.20.4 remote-as 65000
        neighbor 10.0.20.4 timers 3 9
        address-family ipv4 unicast
            neighbor 10.0.20.4 activate
            redistribute connected
        exit-address-family
!