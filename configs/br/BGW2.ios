!
service timestamps debug datetime msec
service timestamps log datetime msec
service password-encryption
!
hostname BGW2
!
no ip domain-lookup
ip domain-name lab.local
!
enable secret admin1234
username admin privilege 15 secret admin1234
!
line con 0
 exec-timeout 0 0
 privilege level 15
 logging synchronous
!
line vty 0 4
 exec-timeout 0 0
 privilege level 15
 login local
 transport input ssh
 logging synchronous
!
ip ssh version 2
!
logging buffered 16384
clock timezone KST 9 0
!
banner motd #
 LAB BGW2 - authorized use only
#
!
interface loopback 0
    ip address 10.0.0.32 255.255.255.255
!
interface gigabitethernet 0/0
    description PE3 to Gi3/0
    no ip address
    no shutdown
!
interface gigabitethernet 0/0.100
    description PE3 Gi3/0.100 (VRF BR1)
    encapsulation dot1q 100
    ip address 10.0.60.3 255.255.255.254
!
interface gigabitethernet 1/0
    description DSW2 to Gi0/0
    ip address 10.50.0.2 255.255.255.254
    no shutdown
!
router ospf 1
    router-id 10.0.0.32
    no passive-interface default
    passive-interface loopback 0
    default-information originate always
!
interface loopback 0
    ip ospf 1 area 0
!
interface gigabitethernet 1/0
    ip ospf network point-to-point
    ip ospf hello-interval 1
    ip ospf dead-interval 4
    ip ospf 1 area 0
!
ip prefix-list BR-TO-PARTNER seq 5 permit 192.168.50.0/24
ip prefix-list BR-TO-PARTNER seq 10 permit 192.168.60.0/24
ip prefix-list PARTNER-TO-BR seq 5 permit 192.168.110.0/24
ip prefix-list PARTNER-TO-BR seq 10 permit 192.168.10.0/24
ip prefix-list PARTNER-TO-BR seq 15 permit 192.168.20.0/24
!
router bgp 65020
    bgp router-id 10.0.1.32
    bgp log-neighbor-changes
    no bgp default ipv4-unicast
    neighbor 10.0.60.2 remote-as 65000
    neighbor 10.0.60.2 timers 3 9
    !
    address-family ipv4
        neighbor 10.0.60.2 activate
        neighbor 10.0.60.2 prefix-list BR-TO-PARTNER out
        neighbor 10.0.60.2 prefix-list PARTNER-TO-BR in
        network 192.168.50.0 mask 255.255.255.0
        network 192.168.60.0 mask 255.255.255.0
    exit-address-family
!
