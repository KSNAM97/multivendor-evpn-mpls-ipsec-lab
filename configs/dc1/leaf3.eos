!
hostname LEAF3
!
service routing protocols model multi-agent
!
username admin privilege 15 role network-admin secret admin1234
!
management console
   idle-timeout 0
!
management ssh
   idle-timeout 0
   no shutdown
!
interface management1
   ip address 192.168.100.23/24
!
interface loopback0
   description ROUTER-ID
   ip address 10.1.0.13/32
!
interface loopback1
   description VTEP
   ip address 10.1.1.34/32
!
logging buffered 64000
clock timezone Asia/Seoul
!
ip routing
!
vrf instance TENANT-A
!
ip routing vrf TENANT-A
!
ip virtual-router mac-address 00:1c:73:00:00:99
!
vlan 10
   name APP
vlan 20
   name DB
vlan 999
   name NATIVE
vlan 4094
   name MLAG-PEER
   trunk group MLAGPEER
!
spanning-tree mode mstp
no spanning-tree vlan-id 4094
!
interface vlan10
   description APP-GW
   vrf TENANT-A
   ip address virtual 192.168.10.1/24
!
interface vlan20
   description DB-GW
   vrf TENANT-A
   ip address virtual 192.168.20.1/24
!
interface vlan4094
   ip address 10.1.254.2/31
   no autostate
!
interface ethernet1
   description spine1 to ethernet3
   no switchport
   ip address 10.1.10.5/31
   no shutdown
!
interface ethernet2
   description spine2 to ethernet3
   no switchport
   ip address 10.1.10.13/31
   no shutdown
!
interface port-channel1
   description MLAG-PEERLINK
   switchport mode trunk
   switchport trunk native vlan 999
   switchport trunk group MLAGPEER
!
interface ethernet3
   channel-group 1 mode active
!
interface ethernet4
   channel-group 1 mode active
!
mlag configuration
   domain-id MLAG2
   local-interface vlan4094
   peer-address 10.1.254.3
   peer-link port-channel1
exit
!
interface ethernet7
   description to-HostB
    spanning-tree portfast
   spanning-tree bpduguard enable
   switchport mode access
   switchport access vlan 10
!
interface vxlan1
   vxlan source-interface loopback1
   vxlan udp-port 4789
   vxlan vlan 10 vni 10010
   vxlan vlan 20 vni 10020
   vxlan vrf TENANT-A vni 50001
   vxlan virtual-router encapsulation mac-address mlag-system-id
!
ip access-list MGMT-ACL
   10 permit tcp 192.168.100.0/24 any eq ssh
   20 permit icmp 192.168.100.0/24 any
   30 permit ospf any any
   40 permit tcp 10.1.0.0/24 any eq bgp
   50 permit tcp 10.1.0.0/24 eq bgp any
   60 permit ip 10.1.254.0/24 any
   70 permit icmp 10.0.0.0/8 any
   80 deny ip any any log
!
system control-plane
   ip access-group MGMT-ACL in
!
router ospf 1
   router-id 10.1.0.13
   passive-interface loopback0
   passive-interface loopback1
   max-lsa 12000
!
interface loopback0
   ip ospf area 0.0.0.0
!
interface loopback1
   ip ospf area 0.0.0.0
!
interface ethernet1
   ip ospf network point-to-point
   ip ospf area 0.0.0.0
   ip ospf hello-interval 1
   ip ospf dead-interval 4
!
interface ethernet2
   ip ospf network point-to-point
   ip ospf area 0.0.0.0
   ip ospf hello-interval 1
   ip ospf dead-interval 4
!
router bgp 65100
   router-id 10.1.2.13
   no bgp default ipv4-unicast
   maximum-paths 4 ecmp 4
   neighbor SPINES peer group
   neighbor SPINES remote-as 65100
   neighbor SPINES timers 3 9
   neighbor SPINES update-source loopback0
   neighbor SPINES send-community extended
   neighbor 10.1.0.1 peer group SPINES
   neighbor 10.1.0.2 peer group SPINES
   !
   vlan 10
      rd 10.1.2.13:10010
      route-target both 10010:10010
      redistribute learned
   !
   vlan 20
      rd 10.1.2.13:10020
      route-target both 10020:10020
      redistribute learned
   !
   address-family evpn
      neighbor SPINES activate
   !
   vrf TENANT-A
      rd 10.1.2.13:50001
      route-target import evpn 50001:50001
      route-target export evpn 50001:50001
      redistribute connected
!
interface ethernet5
   description PE1 to Gi2/0
   no switchport
   vrf TENANT-A
   ip address 10.0.20.1/31
   no shutdown
!
interface ethernet6
   description Hub1 to Gi1/0
   no switchport
   vrf TENANT-A
   ip address 10.0.31.0/31
   no shutdown
!
router bgp 65100
   vrf TENANT-A
      router-id 10.1.2.13
      neighbor 10.0.20.0 remote-as 65000
      neighbor 10.0.20.0 timers 3 9
      neighbor 10.0.31.1 remote-as 65010
      neighbor 10.0.31.1 timers 3 9
      !
      address-family ipv4
         neighbor 10.0.20.0 activate
         neighbor 10.0.31.1 activate
!