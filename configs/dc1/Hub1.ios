!
service timestamps debug datetime msec
service timestamps log datetime msec
service password-encryption
!
hostname HUB1
!
no ip domain-lookup
ip domain-name lab.local
!
enable secret admin1234
username admin privilege 15 secret admin1234
!
line con 0
 exec-timeout 0 0
 privilege level 15
 logging synchronous
!
line vty 0 4
 exec-timeout 0 0
 privilege level 15
 login local
 transport input ssh
 logging synchronous
!
ip ssh version 2
!
logging buffered 16384
clock timezone KST 9 0
!
banner motd #
 LAB HUB1 - authorized use only
#
!
interface loopback 0
    ip address 10.0.0.21 255.255.255.255
!
interface gigabitethernet 0/0
    description PE1 to Gi4/0
    ip address 10.0.30.1 255.255.255.254
    no shutdown
!
interface gigabitethernet 1/0
    description leaf3 to Et6
    ip address 10.0.31.1 255.255.255.254
    no shutdown
!
interface gigabitethernet 2/0
    description leaf4 to Et8
    ip address 10.0.32.3 255.255.255.254
    no shutdown
!
router bgp 65010
    bgp router-id 10.0.1.21
    bgp log-neighbor-changes
    no bgp default ipv4-unicast
    neighbor 10.0.30.0 remote-as 65000
    neighbor 10.0.30.0 timers 3 9
    neighbor 10.0.31.0 remote-as 65100
    neighbor 10.0.31.0 timers 3 9
    neighbor 10.0.32.2 remote-as 65100
    neighbor 10.0.32.2 timers 3 9
    !
    address-family ipv4
        neighbor 10.0.30.0 activate
        neighbor 10.0.31.0 activate
        neighbor 10.0.32.2 activate
    exit-address-family
!
