!
service timestamps debug datetime msec
service timestamps log datetime msec
service password-encryption
!
hostname PE3
!
no ip domain-lookup
ip domain-name lab.local
!
enable secret admin1234
username admin privilege 15 secret admin
!
line con 0
 exec-timeout 0 0
 privilege level 15
 logging synchronous
!
line vty 0 4
 exec-timeout 0 0
 privilege level 15
 login local
 transport input ssh
 logging synchronous
!
ip ssh version 2
!
ip cef
logging buffered 16384
clock timezone KST 9 0
!
banner motd #
 LAB PE3 - authorized use only
#
!
ip vrf BR1
!
interface loopback 0
    ip address 10.0.0.13 255.255.255.255
!
interface gigabitethernet 0/0
    description PE1 to Gi1/0
    ip address 10.0.10.3 255.255.255.254
    no shutdown
!
interface gigabitethernet 1/0
    description PE2 to Gi1/0
    ip address 10.0.10.5 255.255.255.254
    no shutdown
!
interface gigabitethernet 2/0
    description BGW1 to Gi0/0
    no ip address
    no shutdown
!
interface gigabitethernet 2/0.100
    description BGW1 Gi0/0.100 (VRF BR1)
    encapsulation dot1q 100
    ip vrf forwarding BR1
    ip address 10.0.60.0 255.255.255.254
!
interface gigabitethernet 3/0
    description BGW2 to Gi0/0
    no ip address
    no shutdown
!
interface gigabitethernet 3/0.100
    description BGW2 Gi0/0.100 (VRF BR1)
    encapsulation dot1q 100
    ip vrf forwarding BR1
    ip address 10.0.60.2 255.255.255.254
!
router ospf 1
    router-id 10.0.0.13
    no passive-interface default
    passive-interface loopback 0
!
interface loopback 0
    ip ospf 1 area 0
!
interface gigabitethernet 0/0
    ip ospf network point-to-point
    ip ospf hello-interval 1
    ip ospf dead-interval 4
    ip ospf 1 area 0
!
interface gigabitethernet 1/0
    ip ospf network point-to-point
    ip ospf hello-interval 1
    ip ospf dead-interval 4
    ip ospf 1 area 0
!
exit
!
mpls label protocol ldp
mpls ldp router-id loopback 0 force
!
interface gigabitethernet 0/0
    mpls ip
!
interface gigabitethernet 1/0
    mpls ip
!
ip vrf BR1
    rd 65000:3
    route-target export 65000:3
    route-target import 65000:1
    route-target import 65000:2
    route-target import 65000:3
!
router bgp 65000
    bgp router-id 10.0.1.13
    bgp log-neighbor-changes
    no bgp default ipv4-unicast
    neighbor 10.0.0.11 remote-as 65000
    neighbor 10.0.0.11 update-source loopback 0
    neighbor 10.0.0.11 timers 3 9
    neighbor 10.0.0.12 remote-as 65000
    neighbor 10.0.0.12 update-source loopback 0
    neighbor 10.0.0.12 timers 3 9
    !
    address-family vpnv4
        neighbor 10.0.0.11 activate
        neighbor 10.0.0.11 send-community extended
        neighbor 10.0.0.12 activate
        neighbor 10.0.0.12 send-community extended
    exit-address-family
    !
    address-family ipv4 vrf BR1
        neighbor 10.0.60.1 remote-as 65020
        neighbor 10.0.60.1 activate
        neighbor 10.0.60.1 timers 3 9
        neighbor 10.0.60.3 remote-as 65020
        neighbor 10.0.60.3 activate
        neighbor 10.0.60.3 timers 3 9
        maximum-paths 2
    exit-address-family
!
