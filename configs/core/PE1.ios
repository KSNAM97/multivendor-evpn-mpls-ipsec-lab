!
service timestamps debug datetime msec
service timestamps log datetime msec
service password-encryption
!
hostname PE1
!
no ip domain-lookup
ip domain-name lab.local
!
enable secret admin1234
username admin privilege 15 secret admin1234
!
line con 0
 exec-timeout 0 0
 privilege level 15
 logging synchronous
!
line vty 0 4
 access-class MGMT-ACL in vrf-also
 exec-timeout 0 0
 privilege level 15
 login local
 transport input ssh
 logging synchronous
!
ip ssh version 2
!
ip cef
logging buffered 16384
clock timezone KST 9 0
!
banner motd #
 LAB PE1 - authorized use only
#
!
ip vrf TENANT-A
!
interface loopback 0
    ip address 10.0.0.11 255.255.255.255
!
interface gigabitethernet 0/0
    description PE2 to Gi0/0
    ip address 10.0.10.0 255.255.255.254
    no shutdown
!
interface gigabitethernet 1/0
    description PE3 to Gi0/0
    ip address 10.0.10.2 255.255.255.254
    no shutdown
!
interface gigabitethernet 2/0
    description Hub1 to Gi0/0
    ip vrf forwarding TENANT-A
    ip address 10.0.30.0 255.255.255.254
    no shutdown
!
interface gigabitethernet 5/0
    description Hub2 to Gi0/0
    ip vrf forwarding TENANT-A
    ip address 10.0.30.2 255.255.255.254
    no shutdown
!
router ospf 1
    router-id 10.0.0.11
    no passive-interface default
    passive-interface loopback 0
!
interface loopback 0
    ip ospf 1 area 0
!
interface gigabitethernet 0/0
    ip ospf network point-to-point
    ip ospf hello-interval 3
    ip ospf dead-interval 9
    ip ospf 1 area 0
!
interface gigabitethernet 1/0
    ip ospf network point-to-point
    ip ospf hello-interval 3
    ip ospf dead-interval 9
    ip ospf 1 area 0
!
exit
!
mpls label protocol ldp
mpls ldp router-id loopback 0 force
!
interface gigabitethernet 0/0
    mpls ip 
!
interface gigabitethernet 1/0
    mpls ip 
!
ip vrf TENANT-A
    rd 65000:1
    route-target export 65000:1
    route-target import 65000:1
    route-target import 65000:3
!
router bgp 65000
    bgp router-id 10.0.1.11
    bgp log-neighbor-changes
    no bgp default ipv4-unicast
    neighbor 10.0.0.12 remote-as 65000
    neighbor 10.0.0.12 update-source loopback 0
    neighbor 10.0.0.12 timers 30 90
    neighbor 10.0.0.13 remote-as 65000
    neighbor 10.0.0.13 update-source loopback 0
    neighbor 10.0.0.13 timers 30 90
    !
    address-family vpnv4
        neighbor 10.0.0.12 activate
        neighbor 10.0.0.12 send-community extended
        neighbor 10.0.0.13 activate
        neighbor 10.0.0.13 send-community extended
    exit-address-family
!
router bgp 65000
    address-family ipv4 vrf TENANT-A
        neighbor 10.0.30.1 remote-as 65010
        neighbor 10.0.30.1 activate
        neighbor 10.0.30.1 timers 30 90
        neighbor 10.0.30.3 remote-as 65010
        neighbor 10.0.30.3 activate
        neighbor 10.0.30.3 timers 30 90
        maximum-paths 2
    exit-address-family
!
!
! management (core): VRF MGMT on Gi6/0 to MGMT-SW2 (10.9.1.0/24)
ip vrf MGMT
!
interface GigabitEthernet6/0
 description to-MGMT-SW2 (core management)
 ip vrf forwarding MGMT
 ip address 10.9.1.11 255.255.255.0
 no shutdown
!
ip route vrf MGMT 0.0.0.0 0.0.0.0 10.9.1.1
!
ip access-list standard MGMT-ACL
 permit host 10.9.1.10
!
ip access-list extended ACL-COPP-ALLOW
 permit tcp host 10.9.1.10 any eq 22
 permit icmp 10.9.1.0 0.0.0.255 any
!
ip access-list extended ACL-COPP-DENY
 permit tcp any any eq 22
 permit tcp any any eq 23
!
class-map match-all CM-MGMT-ALLOW
 match access-group name ACL-COPP-ALLOW
class-map match-all CM-MGMT-DENY
 match access-group name ACL-COPP-DENY
!
policy-map PM-CONTROL-PLANE
 class CM-MGMT-ALLOW
  police 1000000 conform-action transmit exceed-action drop
 class CM-MGMT-DENY
  drop
!
control-plane
 service-policy input PM-CONTROL-PLANE
!
! SSH key (run once on the device, not stored in config): crypto key generate rsa modulus 2048
